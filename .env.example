# Copy to .env and edit.  cp .env.example .env

# ---- Mode -------------------------------------------------------------------
# paper = simulated money (default, safe). live = REAL orders on Zerodha.
TRADING_MODE=paper
# Live trading only switches on when this is exactly: I_UNDERSTAND_THE_RISKS
LIVE_TRADING_CONFIRM=

# Price data: simulated (offline demo) | yahoo (free, ~15 min delayed) | kite (real-time)
DATA_SOURCE=simulated

# Password to open the app (strongly recommended when using it from your phone)
APP_PASSWORD=

# ---- Stocks -----------------------------------------------------------------
EXCHANGE=NSE
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
CANDLE_INTERVAL=5minute

# ---- Money & risk -----------------------------------------------------------
STARTING_CAPITAL=100000
BOT_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
BREAKEVEN_TRIGGER_PCT=1.0
TRAILING_STOP_PCT=1.0
DAILY_LOSS_LIMIT_PCT=2.0
DAILY_PROFIT_TARGET_PCT=1.5
PROFIT_GIVEBACK_PCT=50
NO_NEW_ENTRIES_AFTER=14:45
SQUARE_OFF_TIME=15:15

# ---- Zerodha Kite Connect (https://developers.kite.trade) --------------------
# Set the app's redirect URL to: http://<your-computer>:8000/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
# Exchanges reject API market/SL-M orders without market protection. -1 = Kite automatic.
KITE_MARKET_PROTECTION=-1
# Only if your host has no fixed IP of its own: route Kite calls via a static-IP proxy.
KITE_PROXY_URL=

# ---- Safety -----------------------------------------------------------------
# Largest value of any single new order in ₹ (exits are never blocked). 0 = no cap.
MAX_ORDER_VALUE=10000
